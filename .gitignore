.DS_Store
.idea/
.vscode/
*.swp

# Composer
**/vendor/
composer.phar

# PHPUnit / coverage
.phpunit.result.cache
.phpunit.cache/
coverage/
build/

# Code style tool caches
.php_cs.cache
.php-cs-fixer.cache
.phpstan.cache/
.psalm.cache/

# Logs
*.log

# Phar distribution artifacts (built, not source)
wscli.phar
wscli.phar.version

# Sensitive: private signing keys must never be committed
wscli-signing.key
*.pem
*.key

# Generated / vendored OpenAPI generator binaries
wscli-php-sdk/swagger-codegen-cli.jar
wscli-php-sdk/openapi-generator-cli.jar

# Local API spec copies (canonical lives on isecure.fi)
wscli-php-sdk/wsapi_v2.json

# Local config / settings that may carry secrets
.settings.yaml
wscli-php/.settings.yaml
.test-account/

# Isolated task worktrees and verification evidence
.private/
