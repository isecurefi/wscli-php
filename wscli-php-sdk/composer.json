{
  "name": "isecurefi/wscli-php-sdk",
  "description": "ISECure WS-Channel PHP SDK — auth helpers wrapping the OpenAPI-generated client.",
  "type": "library",
  "version": "2.1.0",
  "keywords": ["WS-Channel", "wscli-php-sdk", "php-sdk", "isecure"],
  "homepage": "https://www.isecure.fi/",
  "license": "MIT",
  "authors": [
    {
      "name": "Dan Forsberg",
      "email": "dan.forsberg@isecure.fi",
      "homepage": "https://www.isecure.fi",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "dan.forsberg@isecure.fi"
  },
  "repositories": [
    {
      "type": "path",
      "url": "openapi-php-sdk/",
      "options": { "symlink": false }
    }
  ],
  "require": {
    "php": "~8.3.36 || ~8.4.27 || ~8.5.12",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "isecurefi/wsapi-php-client": "^2.0",
    "phpseclib/phpseclib": "^3.0",
    "monolog/monolog": "^3.5",
    "symfony/yaml": "^7.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.9",
    "friendsofphp/php-cs-fixer": "^3.50",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "IsecureFi\\WsApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IsecureFi\\WsApi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": ["phpunit"],
    "test:unit": ["phpunit --testsuite=unit"],
    "test:e2e": ["phpunit --testsuite=e2e"],
    "cs": ["php-cs-fixer fix -v src tests --dry-run --diff"],
    "cs-fix": ["php-cs-fixer fix -v src tests"],
    "stan": ["phpstan analyse src --level=5"]
  }
}
