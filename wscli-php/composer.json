{
  "name": "isecurefi/wscli",
  "description": "ISECure WS-Channel command-line client (Symfony Console + OpenAPI 7 SDK).",
  "type": "project",
  "version": "2.0.0",
  "keywords": ["WS-Channel", "wscli-php", "wscli", "isecure"],
  "homepage": "https://www.isecure.fi/",
  "license": "MIT",
  "authors": [
    {
      "name": "Dan Forsberg",
      "email": "dan.forsberg@isecure.fi",
      "homepage": "https://www.isecure.fi",
      "role": "Lead"
    }
  ],
  "support": {
    "email": "dan.forsberg@isecure.fi"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../wscli-php-sdk/",
      "options": { "symlink": false }
    },
    {
      "type": "path",
      "url": "../wscli-php-sdk/openapi-php-sdk/",
      "options": { "symlink": false }
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-openssl": "*",
    "isecurefi/wscli-php-sdk": "^2.0",
    "isecurefi/wsapi-php-client": "^2.0",
    "symfony/console": "^7.1",
    "symfony/yaml": "^7.1",
    "monolog/monolog": "^3.5",
    "laravel-zero/phar-updater": "^1.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.50",
    "humbug/box": "^4.6"
  },
  "bin": ["bin/wscli"],
  "autoload": {
    "psr-4": {
      "IsecureFi\\WsCli\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IsecureFi\\WsCli\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": ["phpunit"],
    "test:unit": ["phpunit --testsuite=unit"],
    "test:e2e":  ["phpunit --testsuite=e2e"],
    "cs":     ["php-cs-fixer fix -v src tests --dry-run --diff"],
    "cs-fix": ["php-cs-fixer fix -v src tests"],
    "stan":   ["phpstan analyse src --level=5"],
    "phar":   ["box compile -v"]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.x-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "humbug/box": true
    }
  }
}
